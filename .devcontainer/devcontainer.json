{
  "name": "reasonable-answer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    // No github-cli feature: nothing at build time or in `make test` needs `gh` (the suite fakes
    // it), and `dcs`/`dcr` (~/code/util/profile) install it and pass the host token as GH_TOKEN.
    "ghcr.io/devcontainers/features/git:1": {}
  },
  // Mount the checkout at its *host* path rather than the default /workspaces/<repo>.
  // Claude Code keys per-project state (memory, sessions, plans) by the working-directory
  // path, so a container that sees a different path sees an empty project. Aligning the
  // two makes the host and container agents share one project identity.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  // Deliberately NO host credential mounts, neither ~/.claude nor ~/.config/gh. A read-write
  // ~/.claude lets the container's Claude (plugin installs, settings writes, OAuth token refresh)
  // mutate host config and rotate the shared login, which logs out the host and every other
  // session. ~/.config/gh exposes every host the CLI is logged in to, and more than the repo
  // needs. The `dcs`/`dcr` helpers (~/code/util/profile) hand the container only a short-lived
  // Claude access token (CLAUDE_CODE_OAUTH_TOKEN) and the host's GitHub token (GH_TOKEN).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "UV_LINK_MODE": "copy",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
